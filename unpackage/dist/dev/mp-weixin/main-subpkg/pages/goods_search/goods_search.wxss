@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.goods-search {
  min-height: 100vh;
  background: #f4f6fb;
}
.goods-search .search-top {
  background: #bcd1f3;
  padding-bottom: 20rpx;
}
.goods-search .search-box {
  padding: 0 36rpx 14rpx;
}
.goods-search .search-input-wrap {
  display: flex;
  align-items: center;
  width: 100%;
  height: 78rpx;
  padding: 0 8rpx 0 30rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 42rpx;
  box-shadow: 0 8rpx 20rpx rgba(69, 101, 154, 0.08);
}
.goods-search .search-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
}
.goods-search .search-input__placeholder {
  color: #9aa4b5;
  font-size: 28rpx;
  font-weight: 400;
}
.goods-search .search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 62rpx;
  margin-left: 16rpx;
  border-radius: 34rpx;
  background: #1688ff;
  font-weight: 700;
}
.goods-search .search-submit__text {
  margin-right: 6rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}
.goods-search .filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f4f6fb;
}
.goods-search .filter-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.goods-search .filter-item .u-icon {
  margin-left: 8rpx;
}
.goods-search .is-active {
  color: #1f7af4;
}
.goods-search .history-panel {
  padding: 24rpx;
}
.goods-search .word-block {
  padding: 30rpx 0 12rpx;
}
.goods-search .word-title {
  padding-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.goods-search .word-list {
  display: flex;
  flex-wrap: wrap;
}
.goods-search .word-item {
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  padding: 0 26rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: #666666;
  background: #ffffff;
  border-radius: 28rpx;
}
.goods-search .clear-text {
  font-size: 24rpx;
  color: #999999;
}
.goods-search .result-panel {
  padding: 18rpx 24rpx 40rpx;
}
.goods-search .merchant-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(52, 72, 109, 0.04);
}
.goods-search .merchant-card__image {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 192rpx;
  height: 192rpx;
  border-radius: 16rpx;
  background: #f0f2f5;
}
.goods-search .merchant-card__content {
  flex: 1;
  min-width: 0;
  padding: 4rpx 0 4rpx 28rpx;
}
.goods-search .merchant-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.goods-search .merchant-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
  line-height: 44rpx;
}
.goods-search .merchant-card__badge {
  flex: none;
  margin-left: 16rpx;
  padding: 0 14rpx;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #f59d00;
  background: #fff7dc;
  border-radius: 20rpx;
}
.goods-search .merchant-card__score {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}
.goods-search .stars {
  font-size: 28rpx;
  color: #ff6d2d;
  letter-spacing: 0;
}
.goods-search .score {
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #ff6d2d;
}
.goods-search .merchant-card__meta {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  font-size: 26rpx;
  color: #777777;
}
.goods-search .merchant-card__meta text {
  margin-left: 10rpx;
}
.goods-search .merchant-card__distance {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a0a7b4;
}
.goods-search .empty-slot {
  min-height: 760rpx;
}
.goods-search .filter-panel {
  padding: 32rpx 30rpx 40rpx;
  background: #ffffff;
}
.goods-search .filter-panel__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222222;
  line-height: 48rpx;
}
.goods-search .filter-group {
  margin-top: 32rpx;
}
.goods-search .filter-group__label {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.goods-search .filter-price-row {
  display: flex;
  align-items: center;
}
.goods-search .filter-price-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #f5f7fb;
  font-size: 26rpx;
  color: #222222;
  text-align: center;
}
.goods-search .filter-price-line {
  width: 34rpx;
  height: 2rpx;
  margin: 0 18rpx;
  background: #ccd3df;
}
.goods-search .filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
}
.goods-search .filter-chip {
  margin-right: 16rpx;
  margin-bottom: 18rpx;
  padding: 0 28rpx;
  line-height: 66rpx;
  border-radius: 34rpx;
  background: #f5f7fb;
  font-size: 26rpx;
  color: #4b5565;
}
.goods-search .filter-chip.active {
  background: #e8f2ff;
  color: #1688ff;
  font-weight: 600;
}
.goods-search .filter-actions {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}
.goods-search .filter-action {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.goods-search .filter-action.reset {
  margin-right: 18rpx;
  background: #f5f7fb;
  color: #4b5565;
}
.goods-search .filter-action.confirm {
  background: #1688ff;
  color: #ffffff;
}
