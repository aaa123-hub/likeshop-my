<view class="payment-pages"><navbar vue-id="60968672-1" title="{{isFacePay?'面对面付款':'支付订单'}}" bind:__l="__l"></navbar><view class="payment u-skeleton"><block wx:if="{{isFacePay}}"><view class="payment-tips"><u-icon vue-id="60968672-2" name="bell-fill" color="#ffb221" size="52" bind:__l="__l"></u-icon><text>温馨提示：文案填充文案填充文案填充文案填充文案填充文案填充</text></view><view class="face-pay-card"><view class="face-pay-card__field"><text class="face-pay-card__label">付款单号</text><input class="face-pay-card__input" placeholder="请输入付款单号"/></view><view class="face-pay-card__scan"><u-icon vue-id="60968672-3" name="scan" color="#222222" size="52" bind:__l="__l"></u-icon><text>扫一扫</text></view></view></block><block wx:if="{{!isFacePay}}"><view class="payment-header"><price-format class="u-skeleton-fillet" vue-id="60968672-4" subscript-size="{{40}}" first-size="{{56}}" second-size="{{40}}" price="{{amount}}" weight="{{500}}" bind:__l="__l"></price-format><block wx:if="{{timeout>0}}"><view class="payment-count-down"><text>支付剩余时间</text><u-count-down vue-id="60968672-5" timestamp="{{timeout}}" font-size="{{22}}" bind:__l="__l"></u-count-down></view></block></view></block><view class="payment-main"><view class="payway-container u-skeleton-fillet"><u-radio-group bind:input="__e" style="width:100%;" vue-id="60968672-6" value="{{payway}}" data-event-opts="{{[['^input',[['__set_model',['','payway','$event',[]]]]]]}}" bind:__l="__l" vue-slots="{{['default']}}"><view class="payway"><block wx:for="{{paywayList}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['changePayway',['$0'],[[['paywayList','id',item.id,'pay_way']]]]]]]}}" class="payway-item" bindtap="__e"><u-image vue-id="{{('60968672-7-'+index)+','+('60968672-6')}}" src="{{item.icon}}" width="48" height="48" mode="scaleToFill" bind:__l="__l"></u-image><view class="payway-item-content"><text class="payway-item-content-name">{{item.name}}</text><text class="payway-item-content-tips">{{item.extra}}</text></view><u-radio vue-id="{{('60968672-8-'+index)+','+('60968672-6')}}" shape="circle" name="{{item.pay_way}}" active-color="{{primaryColor}}" bind:__l="__l"></u-radio></view></block></view></u-radio-group><block wx:if="{{!$root.g0}}"><view class="payway-empty">暂无支付方式</view></block></view></view><view class="payment-footer u-skeleton-fillet"><view data-event-opts="{{[['tap',[['handlePrepay',['$event']]]]]}}" class="{{['payment-submit',[(loadingPay)?'payment-submit--disabled':'']]}}" bindtap="__e"><u-loading vue-id="60968672-9" mode="circle" show="{{loadingPay}}" bind:__l="__l"></u-loading><text hidden="{{!(!loadingPay)}}">立即支付</text></view></view></view><u-skeleton vue-id="60968672-10" loading="{{loadingSkeleton}}" animation="{{true}}" bgColor="#FFF" bind:__l="__l"></u-skeleton></view>