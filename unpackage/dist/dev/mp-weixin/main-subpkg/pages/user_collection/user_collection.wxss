@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.user-collection .goods-list .collection-item {
  padding: 20rpx;
}
.user-collection .goods-list .collection-item:not(:last-of-type) {
  border-bottom: 1px solid #E5E5E5;
}
.user-collection .goods-list .collection-item .info {
  flex: 1;
}
.user-collection .goods-list .collection-item .goods-img {
  width: 160rpx;
  height: 160rpx;
  flex: none;
}
.user-collection .goods-list .collection-item .btn {
  width: 148rpx;
  height: 52rpx;
  right: 20rpx;
  border: 1px solid #FF2C3C;
  display: flex;
  justify-content: center;
  align-items: center;
}
.user-collection .goods-list .del-btn {
  height: 100%;
  width: 65px;
}
.user-collection .goods-list .store-list {
  height: calc(100vh - 100rpx);
  overflow: hidden;
}
.user-collection .goods-list .store-item {
  height: 140rpx;
  border-bottom: 1rpx solid #E5E5E5;
}
.user-collection .goods-list .store-item .store-img {
  height: 80rpx;
  width: 80rpx;
  border-radius: 50%;
  overflow: hidden;
}
.user-collection .goods-list .tips-dialog {
  height: 230rpx;
  width: 100%;
}
.user-collection .goods-list .data-null {
  padding-top: 100rpx;
}
