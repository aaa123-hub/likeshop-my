










































































/* components/my-coupons/my-coupons.wxss */
.my-coupons {
    min-height: calc(100vh - 80rpx);
    box-sizing: border-box;
}
.coupon-empty {
    margin: 160rpx 30rpx 0;
    padding: 80rpx 30rpx;
    background: #ffffff;
    border-radius: 24rpx;
    text-align: center;
    box-shadow: 0 12rpx 36rpx rgba(24, 40, 80, 0.04);
}
.coupon-empty__title {
    color: #333333;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 42rpx;
}
.coupon-empty__desc {
    margin-top: 14rpx;
    color: #999999;
    font-size: 24rpx;
    line-height: 34rpx;
}

