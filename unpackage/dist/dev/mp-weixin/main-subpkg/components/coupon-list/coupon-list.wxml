<view class="coupon-list"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="coupon-list__row"><view class="{{['coupon-item '+(btnType==1||btnType==2?'gray':'')]}}"><view class="price white column-center"><view class="xl"><price-format vue-id="{{'5f1e0936-1-'+index}}" first-size="{{60}}" second-size="{{50}}" subscript-size="{{34}}" price="{{item.money}}" weight="{{500}}" bind:__l="__l"></price-format></view><view class="sm coupon-condition">{{item.use_condition}}</view></view><view class="info"><view class="coupon-name">{{item.name||'优惠券'}}</view><view class="coupon-time">{{item.use_time_tips||'有效期以实际使用规则为准'}}</view><view class="coupon-type">{{item.coupon_type||item.use_condition}}</view></view><button class="{{['btn br60 white xs '+(btnType!=3?'plain':'')]}}" type="primary" data-event-opts="{{[['tap',[['onHandle',['$0'],[[['list','',index,'id']]]]]]]}}" bindtap="__e">{{''+getBtn+''}}</button><block wx:if="{{item.is_get}}"><image class="receive" src="https://shengyuan.store/api/miniapp/files/miniapp/d0588ecf8c374aee9b7341164eea1708/coupon_receive.png"></image></block></view><block wx:if="{{item.tips}}"><view data-event-opts="{{[['tap',[['onShowTips',[index]]]]]}}" class="coupon-tips bg-white" bindtap="__e"><view class="row-between"><view class="xs">使用说明</view><u-icon class="{{[showTips[index]?'rotate':'']}}" vue-id="{{'5f1e0936-2-'+index}}" name="arrow-down" bind:__l="__l"></u-icon></view><view hidden="{{!(showTips[index])}}" class="mt10 xs">{{item.tips}}</view></view></block></view></block></view>