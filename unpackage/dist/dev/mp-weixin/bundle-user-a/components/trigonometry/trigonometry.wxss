
.trigonometry {
  border-color: transparent transparent currentcolor currentcolor;
  border-style: solid;
  border-width: 3px;
  -webkit-transform: rotate(-45deg);
  transform: rotate(-45deg);
  opacity: .8;
  margin: -3px 10rpx 0;
}
.up {
  margin-top: 1rpx;
  -webkit-transform: rotate(135deg);
  transform: rotate(135deg);
}
.small {
  border-width: 2px;
  margin-top: -2px;
}
.small.up {
  margin-top: 2px;
}

