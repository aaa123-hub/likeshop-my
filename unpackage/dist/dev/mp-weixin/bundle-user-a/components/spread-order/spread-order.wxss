@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.spread-order .spread-header {
  height: 240rpx;
  background-color: var(--primary-color);
  padding-top: 60rpx;
}
.spread-order .spread-header .deal-num {
  flex: 1;
  align-self: flex-start;
}
.spread-order .spread-header .deal-num .num {
  font-size: 42rpx;
}
.spread-order .spread-header .deal-num .explain {
  line-height: 34rpx;
  margin-top: 16rpx;
}
.spread-order .spread-header .income-num {
  flex: 1;
  align-self: flex-start;
}
.spread-order .spread-header .income-num .explain {
  line-height: 34rpx;
  margin-top: 12rpx;
}
.spread-order .content {
  padding: 0 20rpx;
  /* margin-top: -120rpx; */
}
.spread-order .content .order-container .order-item {
  border-radius: 14rpx;
}
.spread-order .content .order-container .order-item .order-header {
  padding: 20rpx 30rpx;
  border-bottom: var(--border);
}
.spread-order .content .order-container .order-item .order-header .status {
  /* background: linear-gradient(80deg, #F95F2F 0%, #FF2C3C 100%);
  border-radius: 4rpx;
  width: 134rpx;
  height: 42rpx;
  font-size: 24rpx;
  line-height: 34rpx; */
  color: #F95F2F;
}
.spread-order .content .order-container .order-item .order-content {
  padding: 20rpx 30rpx 20rpx 20rpx;
  border-bottom: var(--border);
}
.spread-order .content .order-container .order-item .order-content .order-goods-img {
  width: 140rpx;
  height: 140rpx;
  flex: none;
}
.spread-order .content .order-container .order-item .order-content .order-goods-info {
  text-align: left;
  flex: 1;
}
.spread-order .content .order-container .order-item .order-content .order-goods-info .name {
  line-height: 36rpx;
}
.spread-order .content .order-container .order-item .order-content .order-goods-info .pre-income {
  line-height: 34rpx;
  margin-top: 8rpx;
}
.spread-order .content .order-container .order-item .order-footer {
  padding: 20rpx 30rpx 20rpx 20rpx;
}
.spread-order .content .order-container .order-item .order-footer .static {
  color: #F95F2F;
}
.spread-order .content .order-container .order-item .order-footer .wait-return {
  color: #F95F2F;
}
.data-null {
  padding-top: 200rpx;
}
