<view class="activity-detail-contain"><block wx:if="{{$root.g0}}"><view class="header row-start"><text class="white header-title">{{''+title+''}}<text class="white xxs ml20">{{name}}</text></text></view></block><view class="content"><view class="goods-container"><block wx:for="{{goodsList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><navigator class="goods-item bg-white row mb10" url="{{'/main-goods/main-goods/pages/goods_details/goods_details?id='+item.id}}" hover-class="none"><view class="goods-img"><custom-image vue-id="{{'98dca386-1-'+index}}" width="100%" height="100%" radius="6rpx" lazy-load="{{true}}" src="{{item.image}}" bind:__l="__l"></custom-image></view><view class="goods-info ml20"><view class="goods-name line2 normal nr mb10">{{item.name}}</view><view class="count-buy br60 xxs">{{"累计"+item.sales_sum+"人购买"}}</view><view class="row-between mt10"><view class="row"><price-format vue-id="{{'98dca386-2-'+index}}" price="{{item.price}}" subscript-size="{{26}}" first-size="{{34}}" second-size="{{26}}" color="#FF2C3C" bind:__l="__l"></price-format><price-format class="ml20" vue-id="{{'98dca386-3-'+index}}" price="{{item.market_price}}" subscript-size="{{24}}" first-size="{{24}}" second-size="{{24}}" color="#999999" bind:__l="__l"></price-format></view><view class="buy-btn row-center br60"> 马上抢 </view></view></view></navigator></block></view><loading-footer vue-id="98dca386-4" slot-empty="{{true}}" status="{{status}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" style="padding-top:500rpx;" slot="empty"><view class="lighter">暂无活动商品～</view></view></loading-footer></view></view>