<view class="license"><navbar vue-id="33d4cebd-1" title="商家资质" background="{{({background:'transparent'})}}" title-color="#ffffff" bind:__l="__l"></navbar><view class="license-header"></view><block wx:if="{{status.audit_status}}"><view class="license-status"><view class="license-status__label">申请状态</view><view class="{{['license-status__value',statusClass]}}">{{statusText}}</view><block wx:if="{{status.audit_remark}}"><view class="license-status__remark">{{status.audit_remark}}</view></block><block wx:if="{{status.updated_at}}"><view class="license-status__time">{{status.updated_at}}</view></block></view></block><view class="license-card"><view class="license-item"><view class="license-item__label">店铺名称</view><input class="license-item__input" placeholder="请输入您的店铺名称" data-event-opts="{{[['input',[['__set_model',['$0','merchantName','$event',[]],['form']]]]]}}" value="{{form.merchantName}}" bindinput="__e"/><u-icon vue-id="33d4cebd-2" name="arrow-right" size="28" color="#222222" bind:__l="__l"></u-icon></view><view class="license-item"><view class="license-item__label">联系电话</view><input class="license-item__input" type="number" maxlength="11" placeholder="请输入您的电话" data-event-opts="{{[['input',[['__set_model',['$0','contactMobile','$event',[]],['form']]]]]}}" value="{{form.contactMobile}}" bindinput="__e"/><u-icon vue-id="33d4cebd-3" name="arrow-right" size="28" color="#222222" bind:__l="__l"></u-icon></view><view class="license-item"><view class="license-item__label">电子邮箱</view><input class="license-item__input" placeholder="请输入您的电子邮箱" data-event-opts="{{[['input',[['__set_model',['$0','settlementAccountNo','$event',[]],['form']]]]]}}" value="{{form.settlementAccountNo}}" bindinput="__e"/><u-icon vue-id="33d4cebd-4" name="arrow-right" size="28" color="#222222" bind:__l="__l"></u-icon></view></view><view class="license-extra"><view class="license-desc"><view class="license-desc__title">网店说明</view><textarea class="license-desc__textarea" placeholder="请输入网店说明" maxlength="200" data-event-opts="{{[['input',[['__set_model',['$0','remark','$event',[]],['form']]]]]}}" value="{{form.remark}}" bindinput="__e"></textarea><view class="license-desc__count">{{$root.g0+"/200"}}</view></view></view><view data-event-opts="{{[['tap',[['submitApply',['$event']]]]]}}" class="{{['license-btn',(submitting)?'license-btn--disabled':'']}}" bindtap="__e">{{submitting?'提交中...':'去开通'}}</view></view>