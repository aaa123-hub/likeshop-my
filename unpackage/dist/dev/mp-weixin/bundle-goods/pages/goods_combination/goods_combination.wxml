<view class="goods-combination"><navbar vue-id="1d02611a-1" title="拼团活动" bind:__l="__l"></navbar><view class="header"><image class="img" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/group_bg.png"></image></view><view class="main bg-primary"><view class="goods-list"><block wx:for="{{groupList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><navigator class="goods-item row mt20 bg-white" hover-class="none" url="{{'/main-goods/main-goods/pages/goods_details/goods_details?id='+item.goods_id}}"><custom-image vue-id="{{'1d02611a-2-'+index}}" width="180rpx" height="180rpx" radius="6rpx" lazy-load="{{true}}" src="{{item.image}}" bind:__l="__l"></custom-image><view class="goods-info ml20"><view class="goods-name line2 mb10">{{item.name}}</view><view class="dec row"><view class="group mr20 row"><view class="group-img row-center"><image class="icon-sm" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/icon_group_white.png"></image></view><view class="primary xxs mr10 ml10">{{item.people_num+"人团"}}</view></view><view class="sale muted xs">{{"已拼"+item.sales_sum+"件"}}</view></view><view class="info-footer row-between"><view class="price row"><price-format vue-id="{{'1d02611a-3-'+index}}" color="#FF2C3C" subscript-size="{{26}}" second-size="{{26}}" first-size="{{34}}" price="{{item.team_min_price}}" weight="{{500}}" bind:__l="__l"></price-format><price-format class="ml10" vue-id="{{'1d02611a-4-'+index}}" color="#999" line-through="{{true}}" subscript-size="{{24}}" first-size="{{24}}" second-size="{{24}}" price="{{item.min_price}}" bind:__l="__l"></price-format></view><button class="br60 btn white" size="sm" type="primary">去拼团</button></view></view></navigator></block></view><loading-footer vue-id="1d02611a-5" status="{{status}}" slot-empty="{{true}}" color="#fff" data-event-opts="{{[['^refresh',[['getGroupListFun']]]]}}" bind:refresh="__e" bind:__l="__l" vue-slots="{{['empty']}}"><view class="column-center" style="padding-top:200rpx;" slot="empty"><text class="lg" style="color:#FFD4D8;">暂无拼团商品</text></view></loading-footer></view></view>