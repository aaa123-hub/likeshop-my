<view class="prize-record-container"><block wx:for="{{lists}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="prize-record-item row"><custom-image style="width:90rpx;height:90rpx;" vue-id="{{'7bfe3bc1-1-'+index}}" src="{{item.prize_image}}" radius="6rpx" bind:__l="__l"></custom-image><view class="prize-record-info"><view class="lg">{{item.prize_name}}</view><view class="mt20 row-between"><view class="xs lighter">{{item.create_time}}</view><block wx:if="{{item.need_tips}}"><view class="xs primary need-integral-tips">{{item.need_tips}}</view></block></view><view class="xs primary mt10">{{''+item.send_tips+''}}</view></view></view></block><loading-footer vue-id="7bfe3bc1-2" slotEmpty="{{true}}" status="{{loadingStatus}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" slot="empty"><text class="xs muted">暂无抽奖记录～</text></view></loading-footer></view>