/* 行为相关颜色 */
/* bundle-after-a/pages/after_sales_detail/after_sales_detail.wxss */
.after-sales-detail {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}
.after-sales-detail .after-sales-header .after-sales-status {
  padding: 48rpx 30rpx;
  background-color: #555555;
}
.after-sales-detail .after-sales-header .after-sales-explain {
  padding: 20rpx 30rpx 24rpx;
}
.after-sales-detail .negotiation-record {
  padding: 24rpx 30rpx;
}
.after-sales-detail .negotiation-record .arrow {
  width: 28rpx;
  height: 28rpx;
}
.after-sales-detail .return-goods-container {
  padding: 20rpx 24rpx 55rpx;
}
.after-sales-detail .return-goods-container .return-goods-row {
  line-height: 40rpx;
  font-weight: 400;
}
.after-sales-detail .btn-group {
  padding: 0rpx 24rpx;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
}
.after-sales-detail .btn-group .btn {
  padding: 10rpx 34rpx;
  border: 1px solid #999999;
}
.after-sales-detail .goods-container .goods-header {
  padding: 20rpx 24rpx;
}
.after-sales-detail .goods-container .goods-header .store-img {
  width: 40rpx;
  height: 40rpx;
}
.after-sales-detail .goods-container .goods-header .store-name {
  line-height: 40rpx;
  align-self: flex-end;
  font-family: PingFang SC;
}
.after-sales-detail .goods-container .goods-item {
  padding: 25rpx 24rpx;
}
.after-sales-detail .goods-container .goods-item .goods-img {
  width: 180rpx;
  height: 180rpx;
  flex: none;
}
.after-sales-detail .goods-container .goods-item .goods-info {
  margin-left: 24rpx;
  flex: 1;
}
.return-address-contain {
  padding: 20rpx 24rpx 28rpx 30rpx;
}
.return-address-contain .address {
  flex: 1;
  line-height: 38rpx;
}
.return-address-contain .address-title {
  width: 150rpx;
  align-self: flex-start;
  line-height: 40rpx;
}
.return-address-contain .copy-btn {
  flex: 0 0 13%;
  background-color: #F4F4F4;
  color: #555555;
  align-self: flex-start;
  padding: 3rpx 16rpx;
  margin-left: 12rpx;
  border-radius: 4rpx;
}
.tips-dialog {
  height: 230rpx;
  width: 100%;
}
