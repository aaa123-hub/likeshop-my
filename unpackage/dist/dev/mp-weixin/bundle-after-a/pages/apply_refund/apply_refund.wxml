<view><view class="apply-refund"><view class="goods"><view class="row"><custom-image vue-id="debc543e-1" width="160rpx" height="160rpx" radius="6rpx" lazy-load="{{true}}" src="{{goods.image}}" bind:__l="__l"></custom-image><view class="goods-info"><view class="nr line2">{{goods.goods_name}}</view><view class="xs muted mt10">{{goods.spec_value}}</view></view></view></view><view class="opt-box mt20" hidden="{{hiddenOpt}}"><view data-event-opts="{{[['tap',[['onlyRefund',['$event']]]]]}}" class="opt-item row-between border-line" bindtap="__e"><view><view class="lg normal">仅退款</view><view class="muted xs mt10">未收到货，与卖家协商同意无需退货只需退款</view></view><image style="width:28rpx;height:28rpx;" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/arrow_right.png"></image></view><view data-event-opts="{{[['tap',[['allRefunds',['$event']]]]]}}" class="opt-item row-between" bindtap="__e"><view><view class="lg normal">退货退款</view><view class="muted xs mt10">已收到货，需退还收到的实物</view></view><image style="width:28rpx;height:28rpx;" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/arrow_right.png"></image></view></view><view hidden="{{!hiddenOpt}}"><view class="refund-info row-between mt20"><view class="lable">数量</view><view>{{goods.goods_num}}</view></view><view class="refund-info row-between"><view class="lable">退款金额</view><price-format vue-id="debc543e-2" color="#FF2C3C" price="{{$root.m0+$root.m1}}" showSubscript="true" subscriptSize="{{28}}" firstSize="{{28}}" secondSize="{{28}}" bind:__l="__l"></price-format></view><view data-event-opts="{{[['tap',[['showPopup',['$event']]]]]}}" class="refund-info row-between" bindtap="__e"><view class="lable">退款原因</view><view class="row"><text class="{{['nr '+(reasonIndex==-1?'muted':'normal')]}}">{{reasonIndex==-1?"请选择":reason[reasonIndex]}}</text><image class="icon-sm ml20" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/arrow_right.png"></image></view></view><view class="refund-info row"><view class="label">备注说明</view><textarea hidden="{{!(!showPop)}}" class="bg-body" placeholder="请描述申请售后的具体原因，100字以内" name="textarea" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"></textarea></view><view class="upload bg-white"><view class="title row-between"><view>上传凭证</view><view class="muted">（选填，最多可上传1张）</view></view><uploader vue-id="debc543e-3" deletable="{{true}}" preview-size="160rpx" file-list="{{fileList}}" image-fit="aspectFill" data-event-opts="{{[['^afterRead',[['afterRead']]],['^delete',[['deleteImage']]]]}}" bind:afterRead="__e" bind:delete="__e" bind:__l="__l"></uploader></view><button class="btn br60" type="primary" size="lg" data-event-opts="{{[['tap',[['onSubmit',['$event']]]]]}}" bindtap="__e"> 申请退款 </button></view></view><u-popup bind:input="__e" vue-id="debc543e-4" id="popup" mode="bottom" value="{{showPop}}" data-event-opts="{{[['^input',[['__set_model',['','showPop','$event',[]]]]]]}}" bind:__l="__l" vue-slots="{{['default']}}"><view class="pop-container bg-white"><view class="pop-header row-center md normal"> 退款原因 </view><scroll-view style="height:800rpx;" scroll-y="{{true}}"><view class="reason-box mt20"><radio-group data-event-opts="{{[['change',[['radioChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{reason}}" wx:for-item="item" wx:for-index="index" wx:key="index"><label data-event-opts="{{[['tap',[['hidePopup',['$event']]]]]}}" class="reason-item row-between" bindtap="__e"><view class="reason-desc nr">{{''+item+''}}</view><radio value="{{index}}"></radio></label></block></radio-group></view></scroll-view></view></u-popup></view>