<view class="balance-transfer"><view class="contain bg-white"><input style="height:100rpx;" type="text" placeholder="请输入对方会员ID/手机号码进行转账" data-event-opts="{{[['input',[['__set_model',['','userSn','$event',[]]]]]]}}" value="{{userSn}}" bindinput="__e"/></view><view class="contain transfer-money bg-white mt20"><view class="muted xs">转账金额</view><view class="input row-center"><view style="font-size:23px;align-self:flex-end;margin-bottom:5px;">¥</view><input type="digit" placeholder="0.00" data-event-opts="{{[['input',[['__set_model',['','money','$event',[]]]]]]}}" value="{{money}}" bindinput="__e"/><view class="column" style="flex:none;"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="xs primary" style="text-align:right;" bindtap="__e">全部</view><view class="xs mt10" style="color:#bbbbbb;">{{"钱包余额￥"+wallet.user_money}}</view></view></view><view data-event-opts="{{[['tap',[['transferBtn',['$event']]]]]}}" class="btn lg white row-center br60" bindtap="__e">转账</view><navigator class="mt20 nr lighter row-center" url="/bundle/bundle-after-b/bundle-after-b/pages/transfer_record/transfer_record" hover-class="none"> 转账记录</navigator></view><view class="user contain bg-white mt20"><view class="lg bold">最近转账</view><block wx:if="{{$root.g0}}"><view class="list"><block wx:for="{{transferList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" data-event-params="{{({item})}}" class="item row" bindtap="__e"><image class="avatar mr30" src="{{item.avatar}}"></image><view><view class="md">{{item.nickname}}</view><view class="xs muted">{{"会员ID:"+item.sn}}</view></view></view></block></view></block><block wx:else><view class="transfer-empty">暂无转账记录</view></block></view><u-modal vue-id="7daa8041-1" value="{{showTransferInfo}}" show-cancel-button="{{true}}" title="确认转账给" confirm-color="{{primaryColor}}" async-close="{{true}}" confirm-text="确认转账" data-event-opts="{{[['^confirm',[['showInputPwd']]],['^cancel',[['e2']]]]}}" bind:confirm="__e" bind:cancel="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="slot-content row-center" style="padding:40rpx 80rpx;"><view class="transfer-user row"><image class="avatar mr30" src="{{transferInfo.avatar}}"></image><view><view class="md">{{transferInfo.nickname}}</view><view class="xs muted mt10">{{"会员ID:"+transferInfo.sn}}</view></view></view></view></u-modal><set-pay-pwd class="vue-ref" bind:confirm="__e" vue-id="7daa8041-2" data-ref="setPayPwd" data-event-opts="{{[['^confirm',[['transferFun']]]]}}" bind:__l="__l"></set-pay-pwd></view>