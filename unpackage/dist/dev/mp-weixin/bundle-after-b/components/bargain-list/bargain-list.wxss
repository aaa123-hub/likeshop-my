@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.bargain-list-container .bargain-list {
  background-color: #ffffff;
}
.bargain-list-container .bargain-list .header {
  height: 80rpx;
  padding: 20rpx 20rpx;
}
.bargain-list-container .bargain-list .content {
  padding: 30rpx 24rpx 18rpx;
}
.bargain-list-container .bargain-list .content .goods-info {
  margin-left: 24rpx;
  flex: 1;
}
.bargain-list-container .bargain-list .content .goods-info .goods-name {
  line-height: 40rpx;
}
.bargain-list-container .bargain-list .footer {
  padding: 19rpx 24rpx;
}
.bargain-list-container .bargain-list .footer .bargain-btn {
  height: 62rpx;
  padding: 0 44rpx;
  background-color: #FF2C3C;
}
.bargain-list-container .bargain-list .footer .purchase-btn {
  height: 62rpx;
  padding: 0 44rpx;
  background-color: rgba(255, 44, 60, 0.1);
}
.bargain-list-container .bargain-list .footer .footer-btn:not(:last-child) {
  margin-right: 20rpx;
}
.bargain-list-container .data-null {
  margin-top: 150rpx;
}
