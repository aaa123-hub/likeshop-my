<view class="user-order"><view class="order-top"><view class="order-switch"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="order-switch__back" bindtap="__e"><u-icon vue-id="675f9ec0-1" name="arrow-left" size="36" color="#222222" bind:__l="__l"></u-icon></view><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="{{['order-switch__item',activeTop===0?'is-active':'']}}" bindtap="__e"> 全部订单 </view><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="{{['order-switch__item',activeTop===1?'is-active':'']}}" bindtap="__e"> 待领取积分 </view></view><view class="order-tabs"><block wx:for="{{order}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['changeShow',[index]]]]]}}" class="{{['order-tabs__item',active===index?'is-active':'']}}" bindtap="__e">{{''+item.name+''}}</view></block></view></view><view class="order-content"><block wx:for="{{order}}" wx:for-item="item" wx:for-index="index" wx:key="type"><block><block wx:if="{{item.isShow}}"><order-list class="vue-ref-in-for" data-custom-hidden="{{!(active===index)}}" vue-id="{{'675f9ec0-2-'+index}}" order-type="{{item.type}}" data-ref="{{'order'+item.type}}" bind:__l="__l"></order-list></block></block></block></view></view>