<view class="street-page"><view class="street-header"><view class="street-header__title">商街</view><view class="street-search"><input class="street-search__input" confirm-type="search" placeholder="{{streetSearchText}}" placeholder-class="street-search__placeholder" data-event-opts="{{[['confirm',[['onStreetSearch',['$event']]]],['input',[['__set_model',['','streetKeyword','$event',[]]]]]]}}" value="{{streetKeyword}}" bindconfirm="__e" bindinput="__e"/><view data-event-opts="{{[['tap',[['onStreetSearch',['$event']]]]]}}" class="street-search__icon" bindtap="__e"><image class="street-search__icon-image" src="{{streetSearchIcon}}" mode="aspectFit"></image></view></view></view><view class="street-sheet"><view class="street-service-grid"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index"><view class="street-service-item" data-index="{{index}}" data-event-opts="{{[['tap',[['openStreetCategory',['$event']]]],['tap',[['openStreetCategory',['$event']]]]]}}" catchtap="__e"><view class="street-service-item__icon-shell"><block wx:if="{{item.m0}}"><view class="street-service-item__image image-placeholder">无</view></block><block wx:else><image class="street-service-item__image" src="{{item.$orig.image}}" mode="aspectFit"></image></block></view><text class="street-service-item__text">{{item.$orig.name}}</text></view></block></view><view class="street-merchant-list"><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index"><view class="street-merchant-card" data-index="{{index}}" data-event-opts="{{[['tap',[['openStreetMerchant',['$event']]]],['tap',[['openStreetMerchant',['$event']]]]]}}" catchtap="__e"><view class="street-merchant-card__image-shell"><block wx:if="{{item.m1}}"><view class="street-merchant-card__image image-placeholder">无</view></block><block wx:else><image class="street-merchant-card__image" src="{{item.$orig.image}}" mode="aspectFill"></image></block></view><view class="street-merchant-card__body"><view class="street-merchant-card__title line1">{{item.$orig.name}}</view><view class="street-merchant-card__rating"><view class="street-merchant-card__stars"><block wx:for="{{5}}" wx:for-item="starIndex" wx:for-index="__i0__" wx:key="*this"><image class="street-merchant-card__star" src="{{streetStarIcon}}" mode="aspectFit"></image></block></view><text class="street-merchant-card__score">{{item.$orig.score}}</text></view><view class="street-merchant-card__time-row"><image class="street-merchant-card__time-icon" src="{{streetTimeIcon}}" mode="aspectFit"></image><text class="street-merchant-card__time line1">{{item.$orig.meta}}</text></view></view></view></block></view></view></view>