<view class="shop-cart-page"><view class="shop-cart-page__screen"><view class="shop-cart-page__top"><view class="shop-cart-page__title">{{"购物车("+cartCountText+")"}}</view></view><block wx:if="{{isLogin}}"><view class="shop-cart-page__content"><block wx:if="{{cartType===1}}"><view class="cart-list"><block wx:for="{{cartLists}}" wx:for-item="item" wx:for-index="index"><view class="cart-card"><view class="cart-card__shop"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['cart-check',(item.selected==1&&item.cart_status==0)?'is-checked':'',(item.cart_status!=0)?'is-disabled':'']}}" bindtap="__e"><block wx:if="{{item.selected==1&&item.cart_status==0}}"><u-icon vue-id="{{'9fac4ca8-1-'+index}}" name="checkbox-mark" color="#ffffff" size="16" bind:__l="__l"></u-icon></block></view><text class="cart-card__shop-name">{{item.shop_name||'商城自营'}}</text><block wx:if="{{item.cart_status!=0}}"><text class="cart-card__invalid">已失效</text></block></view><view class="cart-card__goods"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" data-event-params="{{({item})}}" class="{{['cart-check','cart-card__goods-check',(item.selected==1&&item.cart_status==0)?'is-checked':'',(item.cart_status!=0)?'is-disabled':'']}}" bindtap="__e"><block wx:if="{{item.selected==1&&item.cart_status==0}}"><u-icon vue-id="{{'9fac4ca8-2-'+index}}" name="checkbox-mark" color="#ffffff" size="16" bind:__l="__l"></u-icon></block></view><navigator class="cart-card__body" hover-class="none" url="{{'/main-goods/main-goods/pages/goods_details/goods_details?id='+item.goods_id}}"><image class="cart-card__image" src="{{item.img}}" mode="aspectFill"></image><view class="cart-card__info"><view class="cart-card__name line2">{{item.name}}</view><view class="cart-card__spec line1">{{item.spec_value_str||'默认规格'}}</view><view class="cart-card__bottom"><view class="cart-card__price"><price-format vue-id="{{'9fac4ca8-3-'+index}}" price="{{item.price}}" firstSize="{{38}}" secondSize="{{26}}" subscriptSize="{{26}}" weight="{{500}}" color="#FF2C3C" bind:__l="__l"></price-format></view></view></view></navigator><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="cart-card__actions" catchtap="__e"><u-number-box vue-id="{{'9fac4ca8-4-'+index}}" disabled="{{item.cart_status!=0}}" value="{{item.goods_num}}" min="{{1}}" max="{{item.item_stock}}" bgColor="#F3F3F3" inputWidth="{{70}}" inputHeight="{{54}}" size="{{28}}" data-event-opts="{{[['^change',[['countChange',['$event','$0','$1'],[[['cartLists','cart_id||index',item.cart_id||index,'cart_id']],[['cartLists','cart_id||index',item.cart_id||index]]]]]]]}}" bind:change="__e" bind:__l="__l"></u-number-box><view data-event-opts="{{[['tap',[['changeDelPopup',['$0'],[[['cartLists','cart_id||index',item.cart_id||index,'cart_id']]]]]]]}}" class="cart-card__delete" bindtap="__e"><u-icon vue-id="{{'9fac4ca8-5-'+index}}" name="trash" color="#A7A7A7" size="24" bind:__l="__l"></u-icon></view></view></view></view></block></view></block><block wx:else><block wx:if="{{cartType===2}}"><view class="cart-empty"><u-empty vue-id="9fac4ca8-6" mode="car" text="购物车暂无任何商品~" iconSize="{{160}}" color="#999999" bind:__l="__l" vue-slots="{{['bottom']}}"><view class="cart-empty__action" slot="bottom"><navigator class="cart-empty__btn" open-type="switchTab" url="/pages/index/index" hover-class="none">去逛逛</navigator></view></u-empty></view></block></block></view></block><block wx:else><view class="cart-login"><u-empty vue-id="9fac4ca8-7" mode="car" text="登录后才能查看购物车哦" iconSize="{{160}}" color="#999999" bind:__l="__l" vue-slots="{{['bottom']}}"><view class="cart-empty__action" slot="bottom"><navigator class="cart-empty__btn cart-empty__btn--login" url="/main-auth/main-auth/pages/login/login" hover-class="none">去登录</navigator></view></u-empty></view></block></view><block wx:if="{{isLogin&&cartType===1}}"><view class="cart-footer"><view class="cart-footer__summary"><view data-event-opts="{{[['tap',[['changeAllSelect',['$event']]]]]}}" class="cart-footer__check" bindtap="__e"><view class="{{['cart-check',(isSelectedAll)?'is-checked':'']}}"><block wx:if="{{isSelectedAll}}"><u-icon vue-id="9fac4ca8-8" name="checkbox-mark" color="#ffffff" size="16" bind:__l="__l"></u-icon></block></view><text class="cart-footer__check-text">{{"已选"+selectedCount+"件"}}</text></view><view class="cart-footer__price"><text class="cart-footer__price-label">合计：</text><text class="cart-footer__price-value">{{"¥"+totalPriceText}}</text></view></view><view data-event-opts="{{[['tap',[['goToConfirm',['$event']]]]]}}" class="{{['cart-footer__pay',(nullSelect)?'disabled':'']}}" bindtap="__e">立即支付</view></view></block><u-modal vue-id="9fac4ca8-9" showCancelButton="{{true}}" confirm-text="狠心删除" confirm-color="#FF2C3C" show-title="{{false}}" value="{{delPopup}}" data-event-opts="{{[['^confirm',[['goodsDelete']]],['^cancel',[['changeDelPopup']]],['^input',[['__set_model',['','delPopup','$event',[]]]]]]}}" bind:confirm="__e" bind:cancel="__e" bind:input="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="cart-delete-dialog"><image class="cart-delete-dialog__icon" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/icon_warning.png"></image><view class="cart-delete-dialog__text">确认删除该商品吗？</view></view></u-modal></view>