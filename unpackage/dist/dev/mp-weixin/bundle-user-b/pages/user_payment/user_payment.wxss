/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
/* bundle-user-b/pages/user_payment/user_payment.wxss */
.user-payment {
  min-height: calc(100vh - 0px);
  padding: 24rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f7fb;
  box-sizing: border-box;
}
.user-payment .payment {
  border-radius: 24rpx;
  overflow: hidden;
  padding: 42rpx 36rpx 38rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 40, 80, 0.06);
}
.user-payment .payment .payment-title {
  color: #222222;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 48rpx;
}
.user-payment .payment .field-label {
  margin-top: 38rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
}
.user-payment .payment .nav {
  margin: 20rpx 95rpx 80rpx;
}
.user-payment .payment .nav .item {
  flex: 1;
}
.user-payment .payment .nav .item .line {
  width: 110rpx;
  height: 2px;
}
.user-payment .payment .line {
  width: 110rpx;
  height: 2px;
}
.user-payment .payment .input {
  margin-top: 18rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
  border: 1rpx solid #edf0f5;
  box-sizing: border-box;
}
.user-payment .payment .input input {
  width: 100%;
  height: 88rpx;
  text-align: left;
  font-size: 30rpx;
}
.user-payment .payment .tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}
.user-payment .btn {
  background: linear-gradient(79deg, #f95f2f 0%, #ff2c3c 100%);
  margin: 48rpx 0 30rpx;
  border: 0;
}
.user-payment .btn.is-disabled {
  opacity: 0.65;
}
.user-payment .fast-payment-container {
  margin-top: 48rpx;
}
.user-payment .fast-payment-container .title {
  font-size: 38rpx;
  line-height: 53rpx;
}
.user-payment .fast-payment-container .fast-pay {
  margin-top: 40rpx;
  gap: 18rpx;
}
.user-payment .fast-payment-container .fast-pay .fast-pay-item {
  position: relative;
  width: calc((100% - 36rpx) / 3);
  height: 150rpx;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  border: 1px solid #FF2C3C;
}
.user-payment .fast-payment-container .fast-pay .fast-pay-item .hot-recharge {
  position: absolute;
  padding: 2rpx 10rpx;
  background: linear-gradient(180deg, #FF2C3C 0%, #F95F2F 100%);
  border-radius: 0 10rpx 0 10rpx;
  font-size: 20rpx;
  top: 0;
  right: 0;
}
.user-payment .fast-payment-container .fast-pay .fast-pay-item .price {
  font-size: 42rpx;
  line-height: 50rpx;
}
.user-payment .fast-payment-container .fast-pay .fast-pay-item .preferential {
  line-height: 32rpx;
}
.user-payment .fast-payment-container .recharge-tips {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 44rpx;
  box-shadow: 0 12rpx 36rpx rgba(24, 40, 80, 0.04);
}
.pay-popup .content {
  padding: 40rpx 0;
  text-align: center;
  width: 560rpx;
  border-radius: 20rpx;
}
.pay-popup .img-icon {
  width: 168rpx;
  height: 118rpx;
  display: inline-block;
}
.pay-popup .btn {
  margin: 80rpx 60rpx 0;
}
