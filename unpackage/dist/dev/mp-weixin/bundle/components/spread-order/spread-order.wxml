<view class="spread-order"><view class="content"><view class="order-container"><block wx:for="{{lists}}" wx:for-item="item" wx:for-index="index" wx:key="order_sn"><view class="order-item bg-white mt20"><view class="order-header row-between"><view>{{"订单编号:"+item.order_sn}}</view><view class="white guide-shop-btn row-center">{{item.status}}</view></view><view class="order-content row"><view class="order-goods-img"><u-image vue-id="{{'2a48ed61-1-'+index}}" width="100%" height="100%" radius="6px" src="{{item.image}}" bind:__l="__l"></u-image></view><view class="order-goods-info ml20"><view class="name row sm">{{item.goods_name}}</view><view class="row-between"><view class="xs">数量<text class="normal nr">{{item.goods_num}}</text></view><view class="xs"> 付款金额 <price-format vue-id="{{'2a48ed61-2-'+index}}" showSubscript="{{true}}" subScriptSize="{{28}}" firstSize="{{28}}" secondSize="{{28}}" weight="bold" price="{{item.pay_price}}" bind:__l="__l"></price-format></view></view><view class="pre-income muted">预估收益 <price-format vue-id="{{'2a48ed61-3-'+index}}" showSubscript="{{true}}" subScriptSize="{{28}}" firstSize="{{28}}" secondSize="{{28}}" color="#FF2C3C" weight="bold" price="{{item.money}}" bind:__l="__l"></price-format></view></view></view><view class="order-footer row-between"><view class="time muted sm">{{item.create_time}}</view><view class="static sm" style="{{'color:'+(item.status=='待返佣'?'#FF2C3C':item.status=='已失效'?'#909090':'#00c735')+';'}}">{{item.status}}</view></view></view></block><loading-footer vue-id="2a48ed61-4" slotEmpty="{{true}}" status="{{loadingStatus}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" slot="empty"><text class="sm muted">暂无其他评价～</text></view></loading-footer></view></view></view>