@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.sale-list {
  /* padding: 20rpx 0; */
}
.sale-list .sale-item .sale-goods-show {
  padding: 20rpx 24rpx;
}
.sale-list .sale-item .sale-goods-show .goods-img {
  height: 160rpx;
  width: 160rpx;
}
.sale-list .sale-item .sale-goods-show .goods-desc {
  margin-left: 24rpx;
  flex: 1;
}
.sale-list .sale-item .sale-goods-show .sale-status {
  padding: 20rpx 40rpx;
  background-color: #f6f6f6;
  border-radius: 6rpx;
}
.sale-list .sale-item .sale-header {
  padding: 20rpx 24rpx;
}
.sale-list .sale-item .sale-header .store-name {
  font-family: PingFang SC;
  line-height: 40rpx;
}
.sale-list .sale-item .sale-footer {
  padding: 0 24rpx 22rpx;
}
.sale-list .sale-item .sale-footer .btn {
  padding: 9rpx 34rpx;
  font-family: PingFang SC;
  border: 1px solid #FF2C3C;
}
.sale-list .sale-item .sale-footer .grey-btn {
  border: 1px solid #cccccc;
  padding: 9rpx 34rpx;
  font-family: PingFang SC;
}
.bottom-opacity {
  opacity: 0.5;
}
.data-null {
  padding-top: 150rpx;
}
.tips-dialog {
  height: 230rpx;
  width: 100%;
}
