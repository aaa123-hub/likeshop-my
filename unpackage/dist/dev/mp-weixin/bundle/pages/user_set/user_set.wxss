@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.user-profile-container .user-profile {
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
}
.user-profile-container .user-profile .user-avatar-box {
  padding: 30rpx;
  background-color: white;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
}
.user-profile-container .user-profile .user-avatar-box .user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.user-profile-container .user-profile .row-info {
  padding: 30rpx 20rpx;
  background-color: white;
}
.user-profile-container .user-profile .row-info .label {
  width: 180rpx;
}
.user-profile-container .user-profile .row-info .bd-btn {
  padding: 8rpx 24rpx;
  border: 1px solid #FF2C3C;
  color: #FF2C3C;
}
.user-profile-container .user-profile .license {
  margin-top: 80rpx;
  color: #a7a7a7;
  text-align: center;
}
.user-profile-container .user-profile .bdb-line {
  border-bottom: 1rpx solid #e5e5e5;
}
.user-profile-container .user-profile .save-btn {
  margin-top: 40rpx;
  height: 88rpx;
  margin-left: 54rpx;
  margin-right: 54rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.user-profile-container .user-profile .updata-btn {
  margin: 0 30rpx;
  margin-top: 40rpx;
  background-color: #0cc267;
}
.user-profile-container .modify-container {
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-bottom: 30rpx;
  width: 580rpx;
  border-radius: 30rpx;
  background-color: #ffffff;
}
.user-profile-container .modify-container .title {
  padding: 26rpx 0rpx;
}
.user-profile-container .modify-container .modify-row {
  padding: 32rpx 0rpx;
  width: 100%;
  border-bottom: 1rpx solid #e5e5e5;
}
.user-profile-container .modify-container .modify-row .send-code-btn {
  border: 1px solid #FF2C3C;
  width: 184rpx;
  height: 62rpx;
  color: #FF2C3C;
}
.user-profile-container .modify-container .btn {
  height: 80rpx;
  padding: 0 180rpx;
  border-radius: 20rpx;
  margin-top: 60rpx;
}
