<view class="set-pwd"><view class="input-container bg-white"><block wx:if="{{hasPayPwd}}"><view class="input-item row"><view class="input-label md normal">原密码</view><u-input bind:input="__e" class="flex1" vue-id="0a13b3ad-1" type="password" placeholder="请输入原来的转账密码" value="{{originPwd}}" data-event-opts="{{[['^input',[['__set_model',['','originPwd','$event',[]]]]]]}}" bind:__l="__l"></u-input></view></block><view class="input-item row"><view class="input-label md normal">转账密码</view><u-input bind:input="__e" class="flex1" vue-id="0a13b3ad-2" type="password" placeholder="{{hasPayPwd?'请输入新的转账密码':'请输入转账密码'}}" value="{{setPwd}}" data-event-opts="{{[['^input',[['__set_model',['','setPwd','$event',[]]]]]]}}" bind:__l="__l"></u-input></view><view class="input-item row"><view class="input-label md normal">确认密码</view><u-input bind:input="__e" class="flex1" vue-id="0a13b3ad-3" type="password" placeholder="请再次确认密码" value="{{comfirmPwd}}" data-event-opts="{{[['^input',[['__set_model',['','comfirmPwd','$event',[]]]]]]}}" bind:__l="__l"></u-input></view><block wx:if="{{hasPayPwd}}"><navigator class="row-end lighter xs mr20" hover-class="none" url="/bundle/pages/forget_pay_pwd/forget_pay_pwd">忘记原密码？</navigator></block><button class="btn bg-primary white br60 row-center" size="lg" type="primary" data-event-opts="{{[['tap',[['setPasswordFun',['$event']]]]]}}" bindtap="__e"> 确认 </button></view></view>