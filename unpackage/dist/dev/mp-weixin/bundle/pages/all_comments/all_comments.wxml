<view><view class="all_comments"><block wx:if="{{!isEmpty}}"><view class="header bg-white"><view class="title xs"><text class="lighter mr10">商品好评率</text><text class="primary">{{percent}}</text></view><view class="tab row"><block wx:for="{{categoryList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><block wx:if="{{item.count}}"><view class="{{['tab-item xs mr10  br60 mb20 '+(type==item.id?'bg-primary white':'common-bg')]}}" data-id="{{item.id}}" data-event-opts="{{[['tap',[['onChangType',['$event']]]]]}}" bindtap="__e">{{''+item.name+"("+item.count+')'}}</view></block></block></block></view></view></block><view class="main bg-white"><view class="evaluation-list"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="evaluation-item"><view class="user-info row"><image class="avatar mr20" src="{{item.$orig.avatar}}"></image><view class="user-name md mr10">{{item.$orig.nickname}}</view><u-rate bind:input="__e" vue-id="{{'d397b17e-1-'+index}}" disabled="{{true}}" size="26rpx" color="#FF2C3C" value="{{item.$orig.goods_comment}}" data-event-opts="{{[['^input',[['__set_model',['$0','goods_comment','$event',[]],[[['commentList','',index]]]]]]]}}" bind:__l="__l"></u-rate></view><view class="muted xs mt10"><text class="mr20">{{item.$orig.create_time}}</text><text hidden="{{!(item.$orig.spec_value_str)}}">{{item.$orig.spec_value_str}}</text></view><block wx:if="{{item.$orig.comment}}"><view class="dec mt20">{{item.$orig.comment}}</view></block><block wx:if="{{item.g0}}"><view class="img mt20 row" style="flex-wrap:wrap;"><block wx:for="{{item.$orig.image}}" wx:for-item="imgitem" wx:for-index="imgindex" wx:key="imgindex"><view class="img-item mr10 mb20" data-current="{{imgitem}}" data-uri="{{item.$orig.image}}" data-event-opts="{{[['tap',[['previewImage',['$event']]]]]}}" bindtap="__e"><custom-image class="goods-img" vue-id="{{'d397b17e-2-'+index+'-'+imgindex}}" width="160rpx" fit="cover" height="160rpx" radius="6rpx" lazy-load="{{true}}" src="{{imgitem}}" bind:__l="__l"></custom-image></view></block></view></block><block wx:if="{{item.$orig.reply}}"><view class="seller-recall-container common-bg mt10"><view class="lighter nr" style="word-wrap:break-word;"> 商家回复：<label class="normal two-txt-cut _span">{{item.$orig.reply}}</label></view></view></block></view></block></view></view></view><loading-footer vue-id="d397b17e-3" status="{{status}}" slotEmpty="{{true}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="column-center" style="padding-top:200rpx;" slot="empty"><text class="lighter">暂无评价</text></view></loading-footer></view>