<view class="user-withdraw-code"><view class="withdraw-code-container mt10"><view class="withdraw-code-contain"><block wx:for="{{withdrawRecords}}" wx:for-item="item" wx:for-index="index" wx:key="index"><navigator class="withdraw-code-item bg-white" hover-class="none" url="{{'/bundle/pages/widthdraw_result/widthdraw_result?id='+item.id+'&type=1'}}"><view class="row-between"><view>{{item.desc}}</view><price-format vue-id="{{'ad37d0fe-1-'+index}}" showSubscript="{{true}}" subScriptSize="{{26}}" firstSize="{{36}}" secondSize="{{36}}" price="{{item.left_money}}" bind:__l="__l"></price-format></view><view class="row-between mt10"><view class="muted xs time">{{item.create_time}}</view><view class="{{['withdraw-status','xs',(item.status==2||item.status==4)?'error-status':'',(item.status==3)?'common-status':'']}}">{{item.status_text}}</view></view><block wx:if="{{item.description&&item.status==4}}"><view class="primary mt10 line1 xs">{{item.description}}</view></block></navigator></block></view><loading-footer vue-id="ad37d0fe-2" status="{{loadingStatus}}" slotEmpty="{{true}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" slot="empty"><text class="muted">暂无提现记录～</text></view></loading-footer></view></view>