<view class="user-address"><navbar vue-id="a7c256fe-1" title="添加地址" bind:__l="__l"></navbar><view class="address-body"><block wx:if="{{hasAddress}}"><radio-group data-event-opts="{{[['change',[['radioChange',['$event']]]]]}}" class="address-list" bindchange="__e"><block wx:for="{{addressList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="address-card" data-id="{{item.id}}" data-event-opts="{{[['tap',[['onSelect',['$event']]]]]}}" bindtap="__e"><view class="address-card__main"><view class="address-card__header"><view class="address-card__name">{{''+item.contact+''}}</view><view class="address-card__phone">{{item.telephone}}</view></view><view class="address-card__detail">{{''+item.province+" "+item.city+" "+item.district+"\n                            "+item.address+''}}</view></view><view class="address-card__footer"><label class="default-wrap"><radio color="#1F7AF4" value="{{item.id+''}}" checked="{{item.is_default=='1'}}"></radio><text>设为默认地址</text></label><view class="address-card__actions"><view data-event-opts="{{[['tap',[['editAddress',['$0'],[[['addressList','',index,'id']]]]]]]}}" class="action-item" catchtap="__e"><u-icon vue-id="{{'a7c256fe-2-'+index}}" name="edit-pen" size="28" color="#222222" bind:__l="__l"></u-icon><text>编辑</text></view><view class="action-item action-item--danger" data-id="{{item.id}}" data-event-opts="{{[['tap',[['showSurePop',['$event']]]]]}}" catchtap="__e"><u-icon vue-id="{{'a7c256fe-3-'+index}}" name="trash" size="28" color="#909399" bind:__l="__l"></u-icon><text>删除</text></view></view></view></view></block></radio-group></block><block wx:else><view class="empty-wrap"><view class="address-empty__text">暂无数据</view></view></block></view><u-modal vue-id="a7c256fe-4" showCancelButton="{{true}}" confirm-text="删除" confirm-color="#1F7AF4" show-title="{{false}}" value="{{deleteSure}}" data-event-opts="{{[['^confirm',[['delAddressFun']]],['^cancel',[['hidePop']]],['^input',[['__set_model',['','deleteSure','$event',[]]]]]]}}" bind:confirm="__e" bind:cancel="__e" bind:input="__e" bind:__l="__l" vue-slots="{{['default']}}"><view class="tips-dialog">确认删除该地址吗？</view></u-modal><view class="footer"><block wx:if="{{isWeixin&&hasAddress}}"><view data-event-opts="{{[['tap',[['getWxAddressFun',['$event']]]]]}}" class="footer__ghost" bindtap="__e"> 微信导入 </view></block><view data-event-opts="{{[['tap',[['addAddress',['$event']]]]]}}" class="footer__btn" bindtap="__e">{{''+(hasAddress?'新增收货地址':'+添加地址')+''}}</view></view></view>