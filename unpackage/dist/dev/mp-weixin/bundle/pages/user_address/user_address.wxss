@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.user-address {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}
.user-address .address-body {
  min-height: calc(100vh - 220rpx);
}
.user-address .address-list {
  padding: 24rpx 24rpx 0;
}
.user-address .address-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(31, 122, 244, 0.06);
}
.user-address .address-card__main {
  padding: 30rpx 28rpx 24rpx;
}
.user-address .address-card__header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  color: #222222;
}
.user-address .address-card__name {
  font-size: 34rpx;
  font-weight: 600;
}
.user-address .address-card__phone {
  margin-left: 18rpx;
  font-size: 28rpx;
}
.user-address .address-card__detail {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666666;
}
.user-address .address-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid #f1f2f5;
}
.user-address .default-wrap {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #222222;
}
.user-address .address-card__actions {
  display: flex;
  align-items: center;
}
.user-address .action-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #222222;
}
.user-address .action-item text {
  margin-left: 8rpx;
}
.user-address .action-item + .action-item {
  margin-left: 28rpx;
}
.user-address .action-item--danger {
  color: #909399;
}
.user-address .empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 360rpx);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}
.user-address .address-empty__image {
  width: 320rpx;
  height: 260rpx;
}
.user-address .address-empty__text {
  margin-top: 22rpx;
  color: #666666;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
}
.user-address .footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}
.user-address .footer__ghost,
.user-address .footer__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.user-address .footer__ghost {
  flex: 1;
  margin-right: 20rpx;
  color: #1f7af4;
  background: #ffffff;
}
.user-address .footer__btn {
  flex: 1;
  color: #ffffff;
  background: #1f7af4;
  box-shadow: 0 14rpx 30rpx rgba(31, 122, 244, 0.18);
}
.tips-dialog {
  padding: 48rpx 0 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #222222;
}
