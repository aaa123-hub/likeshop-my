@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.goods-combination {
  background-color: #FF2C3C;
  min-height: 100vh;
}
.goods-combination .header .img {
  display: block;
  width: 750rpx;
  height: 380rpx;
}
.goods-combination .main {
  padding: 0 20rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 1;
}
.goods-combination .main .goods-list .goods-item {
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
}
.goods-combination .main .goods-list .goods-item .goods-img {
  width: 180rpx;
  height: 180rpx;
  flex: none;
}
.goods-combination .main .goods-list .goods-item .goods-info {
  flex: 1;
  width: 475rpx;
}
.goods-combination .main .goods-list .goods-item .goods-info .group {
  border: 1px solid #FF2C3C;
  border-radius: 4rpx;
}
.goods-combination .main .goods-list .goods-item .goods-info .group .group-img {
  padding: 2rpx 6rpx;
  background: linear-gradient(90deg, #f95f2f 0%, #ff2c3c 100%);
  border-radius: 0 4rpx 4rpx 0;
}
.goods-combination .main .goods-list .goods-item .goods-info .info-footer .btn {
  padding: 0 30rpx;
  background-color: #F95F2F;
}
