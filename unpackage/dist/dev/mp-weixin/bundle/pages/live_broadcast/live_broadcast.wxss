@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
.live-broadcast .broadcast-list {
  padding: 20rpx 20rpx 0;
  overflow: hidden;
}
.live-broadcast .broadcast-list .broadcast-item {
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #fff;
}
.live-broadcast .broadcast-list .broadcast-item:not(:last-of-type) {
  margin-bottom: 20rpx;
}
.live-broadcast .broadcast-list .broadcast-item .img-wrap {
  height: 300rpx;
  position: relative;
  color: #fff;
}
.live-broadcast .broadcast-list .broadcast-item .img-wrap .tag {
  position: absolute;
  top: 0;
  border-radius: 0 60rpx 60rpx 0;
  background: #ccc;
  padding: 8rpx 20rpx;
}
.live-broadcast .broadcast-list .broadcast-item .img-wrap .tag.active {
  background: linear-gradient(#ff2c3c 0%, #f95f2f 100%);
}
.live-broadcast .broadcast-list .broadcast-item .img-wrap .tag .circel {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  background: #fff;
  border-radius: 50%;
}
.live-broadcast .broadcast-list .broadcast-item .img-wrap .tips {
  position: absolute;
  background: linear-gradient(rgba(255, 255, 255, 0) 0%, #808080 100%);
  bottom: 0;
  width: 100%;
  font-weight: 500;
  font-size: 30rpx;
  padding: 42rpx 20rpx 16rpx;
}
.live-broadcast .broadcast-list .broadcast-item .info {
  padding: 20rpx;
}
