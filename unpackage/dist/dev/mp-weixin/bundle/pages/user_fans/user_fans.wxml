<view class="user-fans-box"><view class="header"><view class="top-bar row bg-white md"><view class="{{['bar-item row-center '+(active=='all'?'item-active':'')]}}" data-active="all" data-event-opts="{{[['tap',[['changeTab',['$event']]]]]}}" bindtap="__e">全部粉丝</view><view class="{{['bar-item row-center '+(active=='first'?'item-active':'')]}}" data-active="first" data-event-opts="{{[['tap',[['changeTab',['$event']]]]]}}" bindtap="__e">一级粉丝</view><view class="{{['bar-item row-center '+(active=='second'?'item-active':'')]}}" data-active="second" data-event-opts="{{[['tap',[['changeTab',['$event']]]]]}}" bindtap="__e">二级粉丝</view></view><u-search vue-id="612f6ed7-1" shape="round" background="white" show-action="{{true}}" action-text="确定" placeholder="请输入搜索关键词" value="{{keyword}}" data-event-opts="{{[['^search',[['onSearch']]],['^custom',[['onSearch']]],['^input',[['__set_model',['','keyword','$event',[]]]]]]}}" bind:search="__e" bind:custom="__e" bind:input="__e" bind:__l="__l"></u-search><view class="sort-bar row"><view class="sort-bar-item row-center nr" data-sort-type="0" data-event-opts="{{[['tap',[['sortStatusChange',['$event']]]]]}}" bindtap="__e"><view class="{{[sortType==0?'item-active':'']}}">团队排序</view><view class="column"><trigonometry vue-id="612f6ed7-2" direction="up" color="{{fansSort=='asc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry><trigonometry vue-id="612f6ed7-3" color="{{fansSort=='desc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry></view></view><view class="sort-bar-item row-center nr" data-sort-type="1" data-event-opts="{{[['tap',[['sortStatusChange',['$event']]]]]}}" bindtap="__e"><view class="{{[sortType==1?'item-active':'']}}">金额排序</view><view class="column"><trigonometry vue-id="612f6ed7-4" direction="up" color="{{moneySort=='asc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry><trigonometry vue-id="612f6ed7-5" color="{{moneySort=='desc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry></view></view><view class="sort-bar-item row-center nr" data-sort-type="2" data-event-opts="{{[['tap',[['sortStatusChange',['$event']]]]]}}" bindtap="__e"><view class="{{[sortType==2?'item-active':'']}}">订单排序</view><view class="column"><trigonometry vue-id="612f6ed7-6" direction="up" color="{{orderSort=='asc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry><trigonometry vue-id="612f6ed7-7" color="{{orderSort=='desc'?'#FF2C3C':'#585858'}}" size="small" bind:__l="__l"></trigonometry></view></view></view></view><view class="content"><block wx:if="{{false}}"><view class="data-null"><view class="muted">暂无相关数据...</view></view></block><block wx:else><view class="card-box"><block wx:for="{{fansObject}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="card-item row-between"><view class="row"><view class="card-img"><u-image vue-id="{{'612f6ed7-8-'+index}}" src="{{item.avatar}}" round="{{true}}" width="100%" height="100%" bind:__l="__l"></u-image></view><view class="fans-info ml10"><view class="fans-name row">{{item.nickname}}</view><view class="row lighter mt5"><view>{{item.mobile}}</view><view class="ml20">{{item.create_time}}</view></view></view></view><view class="column xs"><view class="msg"><label class="primary _span">{{item.fans_team+''}}</label>人</view><view class="mt5 msg"><label class="_span">{{item.fans_order+''}}</label>单</view><view class="mt5 msg"><label class="_span">{{item.fans_money+''}}</label>元</view></view></view></block><loading-footer vue-id="612f6ed7-9" status="{{loadingStatus}}" slotEmpty="{{true}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" slot="empty"><text>暂无相关数据...</text></view></loading-footer></view></block></view></view>