@charset "UTF-8";
/**
 * 这里是uni-app内置的常用样式变量
 *
 * uni-app 官方扩展插件及插件市场（https://ext.dcloud.net.cn）上很多三方插件均使用了这些样式变量
 * 如果你是插件开发者，建议你使用scss预处理，并在插件代码中直接使用这些变量（无需 import 这个文件），方便用户通过搭积木的方式开发整体风格一致的App
 *
 */
/**
 * 如果你是App开发者（插件使用者），你可以通过修改这些变量来定制自己的插件主题，实现自定义主题功能
 *
 * 如果你的项目同样使用了scss预处理，你也可以直接在你的 scss 代码中使用如下变量，同时无需 import 这个文件
 */
/* 颜色变量 */
/* 行为相关颜色 */
/* pages/user_fans/user_fans.wxss */
.user-fans-box .header .top-bar {
  padding: 18rpx 50rpx;
  height: 100rpx;
}
.user-fans-box .header .top-bar .bar-item {
  flex: 1;
  line-height: 34rpx;
  height: 100%;
}
.user-fans-box .header .top-bar .bar-item:not(:last-of-type) {
  margin-right: 54rpx;
}
.user-fans-box .header .top-bar .item-active {
  color: white;
  background-color: #FF2C3C;
  border-radius: 100rpx;
  height: 100%;
}
.user-fans-box .header .sort-bar {
  background-color: white;
  height: 80rpx;
}
.user-fans-box .header .sort-bar .sort-bar-item {
  flex: 1;
  line-height: 40rpx;
  height: 100%;
}
.user-fans-box .header .sort-bar .sort-bar-item .item-active {
  color: #FF2C3C;
}
.content .data-null {
  padding-top: 200rpx;
  line-height: 40rpx;
}
.content .card-box {
  margin-top: 20rpx;
}
.content .card-box .card-item {
  padding: 20rpx;
  background-color: white;
}
.content .card-box .card-item .card-img {
  width: 100rpx;
  height: 100rpx;
  flex: none;
}
.content .card-box .card-item .fans-info .fans-name {
  line-height: 44rpx;
}
.content .card-box .card-item .msg {
  line-height: 32rpx;
  text-align: right;
}
.content .card-box .card-item:not(:nth-last-of-type(3)) {
  border-bottom: 1px solid #E5E5E5;
}
