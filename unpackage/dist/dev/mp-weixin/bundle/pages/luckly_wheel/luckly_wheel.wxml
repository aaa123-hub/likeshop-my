<view class="luckly-wheel-container"><view class="header"><image src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/choujiang_bg.png"></image></view><view class="main"><view class="row-end"><navigator class="user-prize row-center" url="/bundle/pages/prize_record/prize_record" hover-class="none"><text class="md" style="color:#7D350C;font-weight:600;">我的奖品</text></navigator></view><view class="wheel-box"><view class="wheel-container"><view class="row-center"><view class="notice-container row"><image class="icon" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/icon_notice.png"></image><block wx:if="{{$root.g0>0}}"><view class="marquee-box ml20"><swiper style="height:33rpx;" autoplay="{{true}}" vertical="{{true}}"><block wx:for="{{record}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item class="row"><text class="xs marquee_text" style="color:#F9EDDD;">{{item.text}}</text></swiper-item></block></swiper></view></block><block wx:else><view class="xs ml20" style="color:#F9EDDD;"><text class="xs" style="color:#F9EDDD;">暂无通知</text></view></block></view></view><view class="message row-between nr"><view>{{"我的积分: "+(user_integral||'-')}}</view><block wx:if="{{config.show_win}}"><navigator class="row" url="/bundle/pages/win_prize_code/win_prize_code" hover-class="none"><image class="mr10" src="https://shengyuan.store/api/miniapp/files/miniapp-static/static/images/choujiang_name_list.png"></image> 中奖名单 </navigator></block></view><view class="wheel"><my-lottery vue-id="6bc73a41-1" lotteryData="{{lists}}" status="{{config.status}}" luckyOrder="{{3}}" circleTimes="{{30}}" data-event-opts="{{[['^begin',[['startLottery']]],['^finish',[['lotteryFinish']]]]}}" bind:begin="__e" bind:finish="__e" bind:__l="__l"></my-lottery></view><view class="num-tips nr">{{'每日可抽奖'+config.limit+'次，具体请查看活动规则'}}</view><view class="rules-box"><view class="lg" style="color:#FCD7D2;margin-bottom:30rpx;">活动规则</view><text class="sm" style="color:#FCD7D2;">{{config.rule+''}}</text></view></view></view><view class="xs row-center" style="color:#FFF2D9;margin-top:30rpx;">本活动的所有奖品，均由商城提供</view></view><u-popup bind:input="__e" vue-id="6bc73a41-2" mode="center" value="{{showResult}}" data-event-opts="{{[['^input',[['__set_model',['','showResult','$event',[]]]]]]}}" bind:__l="__l" vue-slots="{{['default']}}"><view class="result-popup column-center"><view class="result-container column-between"><view class="row-center" style="padding:0 118rpx;margin-top:90rpx;"><text style="color:#F95F2F;font-size:62rpx;text-align:center;">{{resultText}}</text></view><view class="mb20"><view data-event-opts="{{[['tap',[['onClose',['$event']]]]]}}" class="get-btn row-center md br60" bindtap="__e"> 点击收下 </view></view></view><view data-event-opts="{{[['tap',[['onClose',['$event']]]]]}}" style="margin-top:50rpx;" bindtap="__e"><image style="width:62rpx;height:62rpx;" src="https://shengyuan.store/api/miniapp/files/miniapp/fa0fe247de6642b4845f2573ed4e2135/icon_close.png"></image></view></view></u-popup></view>