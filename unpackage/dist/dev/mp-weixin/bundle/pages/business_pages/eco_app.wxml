<view class="eco-page"><view class="eco-bg"><view class="eco-content"><view class="eco-header"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="eco-back" bindtap="__e"></view><text class="eco-title">生态应用</text></view><view class="eco-grid"><block wx:for="{{loopData0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['openApp',['$0'],[[['loopData0','',index]]]]]]]}}" class="eco-card" style="{{'background-image:'+('url('+item.cardBg+')')+';'}}" bindtap="__e"><view class="eco-card__head"><image class="eco-card__icon" src="{{item.icon}}" mode="aspectFill"></image><text class="eco-card__name">{{item.title}}</text></view><view class="eco-card__foot"><text class="eco-card__url">{{item.urlText}}</text><image class="eco-card__arrow" src="{{item.arrow}}" mode="aspectFit"></image></view></view></block></view><block wx:if="{{$root.g0}}"><view class="eco-empty"><view class="eco-empty__title">暂无生态应用</view><view class="eco-empty__desc">应用配置后会展示在这里</view></view></block></view></view></view>