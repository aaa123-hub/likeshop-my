<view class="goods-seckill"><navbar vue-id="8e8ec39a-1" title="限时秒杀" bind:__l="__l"></navbar><view class="banner"><swipers vue-id="8e8ec39a-2" pid="{{14}}" height="284rpx" radius="10rpx" padding="20rpx" bind:__l="__l"></swipers></view><view class="time-list"><scroll-view style="height:120rpx;white-space:nowrap;" scroll-into-view="{{'item-'+currentView}}" scroll-x="true" scroll-with-animation="true"><block wx:for="{{seckillTime}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="time-item column-center" id="{{'item-'+index}}" data-id="{{item.id}}" data-index="{{index}}" data-event-opts="{{[['tap',[['exchangeTime',['$event']]]]]}}" bindtap="__e"><view class="{{['xl bold '+(item.active==1?'primary':'')]}}">{{item.start_time}}</view><view class="{{['sm br60 state '+(item.active===1?'bg-primary white':'')+' '+(item.status===2?'muted':'')]}}" style="{{(item.active==1?'background-color: #FF2C3C;color: white':'')}}">{{''+item.tips+''}}</view></view></block></scroll-view></view><view class="goods-list"><block wx:for="{{seckillGoods}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="goods-item row bg-white" data-id="{{item.id}}" data-shop_id="{{item.shop_id}}" data-event-opts="{{[['tap',[['goGoodsDetail',['$event']]]]]}}" bindtap="__e"><custom-image class="goods-img mr20" vue-id="{{'8e8ec39a-3-'+index}}" width="180rpx" height="180rpx" radius="10rpx" lazy-load="{{true}}" src="{{item.image}}" bind:__l="__l"></custom-image><view class="goods-info"><view class="goods-name line2 mb10" style="width:490rpx;">{{item.name}}</view><label class="sale-info xs primary br60">{{'已抢'+item.sales_sum+'件'}}</label><view class="info-footer row-between" style="margin-top:5rpx;"><view class="price"><price-format class="mr10" vue-id="{{'8e8ec39a-4-'+index}}" price="{{item.seckill_price}}" color="#FF2C3C" firstSize="{{34}}" secondSize="{{26}}" showSubscript="{{true}}" subscriptSize="{{26}}" bind:__l="__l"></price-format><price-format class="line-through muted" vue-id="{{'8e8ec39a-5-'+index}}" price="{{item.min_price}}" color="#999999" firstSize="{{24}}" secondSize="{{24}}" showSubscript="{{true}}" subscriptSize="{{24}}" bind:__l="__l"></price-format></view><button class="{{['br60 white '+(currentStatus==2?'bg-gray':currentStatus==1?'primary-btn':'border-btn')]}}" size="sm" data-id="{{item.id}}" data-shop_id="{{item.shop_id}}" data-event-opts="{{[['tap',[['goGoodsDetail',['$event']]]]]}}" catchtap="__e">{{currentStatus==2?'已结束':currentStatus==1?'立即抢购':'未开始'}}</button></view></view></view></block><loading-footer vue-id="8e8ec39a-6" status="{{loadingStatus}}" slotEmpty="{{true}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="data-null column-center" slot="empty"><view class="muted nr">暂无商品～</view></view></loading-footer></view></view>