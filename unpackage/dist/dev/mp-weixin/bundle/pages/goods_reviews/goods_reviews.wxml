<view class="goods-reviews"><order-goods vue-id="400cd85b-1" list="{{goods}}" bind:__l="__l"></order-goods><view class="goods-evaluate row"><view class="lable">商品评价</view><u-rate vue-id="400cd85b-2" name="goodsRate" count="{{5}}" size="{{42}}" active-color="#FF2C3C" value="{{goodsRate}}" data-event-opts="{{[['^change',[['goodsRateChange']]],['^input',[['__set_model',['','goodsRate','$event',[]]]]]]}}" bind:change="__e" bind:input="__e" bind:__l="__l"></u-rate><view hidden="{{!(!(goodsRate==0))}}" class="{{['desc '+(goodsRate<=2?'muted':'primary')+' ']}}">{{''+goodsRateDesc+''}}</view></view><view class="rate bg-white"><view class="item row mb20"><view class="lable">描述相符</view><u-rate bind:input="__e" vue-id="400cd85b-3" name="descRate" size="{{42}}" active-color="#FF2C3C" value="{{descRate}}" data-event-opts="{{[['^input',[['__set_model',['','descRate','$event',[]]]]]]}}" bind:__l="__l"></u-rate></view><view class="item row mb20"><view class="lable">服务态度</view><u-rate bind:input="__e" vue-id="400cd85b-4" name="serverRate" size="{{42}}" active-color="#FF2C3C" value="{{serverRate}}" data-event-opts="{{[['^input',[['__set_model',['','serverRate','$event',[]]]]]]}}" bind:__l="__l"></u-rate></view><view class="item row"><view class="lable">配送服务</view><u-rate bind:input="__e" vue-id="400cd85b-5" name="deliveryRate" size="{{42}}" active-color="#FF2C3C" value="{{deliveryRate}}" data-event-opts="{{[['^input',[['__set_model',['','deliveryRate','$event',[]]]]]]}}" bind:__l="__l"></u-rate></view></view><view class="goods-dec bg-white mt20"><view class="title mb20 md bold">商品描述</view><view class="textarea mb20" style="background-color:#f5f5f5;"><u-input bind:input="__e" vue-id="400cd85b-6" placeholder="宝贝收到还满意吗，说说你的使用心得。分享给想买的他们吧！！" type="textarea" clearable="{{false}}" height="{{240}}" value="{{comment}}" data-event-opts="{{[['^input',[['__set_model',['','comment','$event',[]]]]]]}}" bind:__l="__l"></u-input></view><uploader vue-id="400cd85b-7" preview-size="180rpx" mutiple="{{true}}" maxUpload="{{5}}" file-list="{{fileList}}" deletable="{{true}}" data-event-opts="{{[['^afterRead',[['afterRead']]],['^delete',[['onDelete']]]]}}" bind:afterRead="__e" bind:delete="__e" bind:__l="__l"></uploader></view><button class="btn br60" form-type="submit" type="primary" size="lg" data-event-opts="{{[['tap',[['onSubmit',['$event']]]]]}}" bindtap="__e"> 立即评价 </button></view>