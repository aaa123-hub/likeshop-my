<view><view class="news_list"><view class="contain"><block wx:if="{{showAd}}"><view class="banner"><swipers vue-id="05de402b-1" pid="{{type?10:7}}" height="300rpx" radius="0rpx" bind:__l="__l"></swipers></view></block><block wx:if="{{$root.g0}}"><tabs vue-id="05de402b-2" active="{{active}}" data-event-opts="{{[['^change',[['changeActive']]]]}}" bind:change="__e" bind:__l="__l" vue-slots="{{['default']}}"><tab vue-id="{{('05de402b-3')+','+('05de402b-2')}}" title="全部" bind:__l="__l"></tab><block wx:for="{{categoryList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><tab vue-id="{{('05de402b-4-'+index)+','+('05de402b-2')}}" title="{{item.name}}" bind:__l="__l"></tab></block></tabs></block><view class="main"><view class="article-list"><block wx:for="{{newsList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="article-item bg-white" data-id="{{item.id}}" data-event-opts="{{[['tap',[['goPage',['$event']]]]]}}" bindtap="__e"><view class="row"><view class="info"><view class="title lg line2 mb20">{{item.title}}</view><view class="lighter line2"><view>{{item.synopsis}}</view></view></view><image class="img ml20" width="240rpx" height="180rpx" lazy-load="{{true}}" src="{{item.image}}"></image></view><view class="row-between mt20"><view class="xs muted">{{"发布时间: "+item.create_time}}</view><view class="row"><view class="ml10 xs muted">{{item.visit+"人浏览"}}</view></view></view></view></block></view><loading-footer vue-id="05de402b-5" status="{{status}}" slotEmpty="{{true}}" bind:__l="__l" vue-slots="{{['empty']}}"><view class="column-center" style="padding-top:100rpx;" slot="empty"><text class="nr muted">暂无数据～</text></view></loading-footer></view></view></view></view>